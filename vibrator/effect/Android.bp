Common_CFlags = ["-Wall", "-Werror"]

cc_library_shared {
    name: "libqtivibratoreffect-awinic",
    vendor: true,
    cflags: Common_CFlags,
    srcs: ["effect.cpp"],
    shared_libs: [
        "liblog",
        "libtinyxml2",
    ],
    header_libs: ["libqtivibratoreffect_headers"],
}

prebuilt_etc {
    name: "awinic_haptic_primitives.xml",
    src: "awinic_haptic_primitives.xml",
    vendor: true,
}
